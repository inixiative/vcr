{
  "name": "@inixiative/vcr",
  "version": "0.1.0",
  "description": "Zero-dependency deterministic cassette recorder, replayer, secret scrubber, structural drift guard, and freshness verifier for HTTP, WebSocket, child processes, and custom transports.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "keywords": [
    "vcr",
    "cassette",
    "replay",
    "record",
    "testing",
    "scrub",
    "redaction",
    "sanitization",
    "drift",
    "inixiative"
  ],
  "author": "Aron Greenspan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/vcr.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./scrub": {
      "import": {
        "types": "./dist/scrub/index.d.ts",
        "default": "./dist/scrub/index.js"
      },
      "require": {
        "types": "./dist/scrub/index.d.cts",
        "default": "./dist/scrub/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http/index.d.ts",
        "default": "./dist/http/index.js"
      },
      "require": {
        "types": "./dist/http/index.d.cts",
        "default": "./dist/http/index.cjs"
      }
    },
    "./process": {
      "import": {
        "types": "./dist/process/index.d.ts",
        "default": "./dist/process/index.js"
      },
      "require": {
        "types": "./dist/process/index.d.cts",
        "default": "./dist/process/index.cjs"
      }
    },
    "./websocket": {
      "import": {
        "types": "./dist/websocket/index.d.ts",
        "default": "./dist/websocket/index.js"
      },
      "require": {
        "types": "./dist/websocket/index.d.cts",
        "default": "./dist/websocket/index.cjs"
      }
    },
    "./freshness": {
      "import": {
        "types": "./dist/freshness/index.d.ts",
        "default": "./dist/freshness/index.js"
      },
      "require": {
        "types": "./dist/freshness/index.d.cts",
        "default": "./dist/freshness/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@inixiative/config": "^0.5.237",
    "@types/bun": "1.4.4",
    "@types/node": "^25.3.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.4"
}
